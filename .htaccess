# Enable RewriteEngine
RewriteEngine On

# Make sure the .htaccess works for subfolders
RewriteBase /

# If the request is for a real file or folder, don't rewrite
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route URLs without .html to their respective folders
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1/index.html [L]

# Optional: Default route for root domain
DirectoryIndex index.html
